+/// perfagent patch: scan glibc's `struct pthread` for the kernel thread id.
+#[cfg(all(target_os = "linux", feature = "unwind"))]
+fn read_tid_from_pthread_struct(process: &Process, pthread: u64, os_tids: &HashSet<Tid>) -> Option<Tid> {
+    const KNOWN_TID_OFFSET: usize = 0x2d0;
+    const SCAN_BYTES: usize = 0x400;
+    let bytes = process.copy(pthread as usize, SCAN_BYTES).ok()?;
+    let at = |offset: usize| -> Option<Tid> {
+        let chunk = bytes.get(offset..offset + 4)?;
+        let candidate = Tid::from_ne_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]);
+        (candidate > 0 && os_tids.contains(&candidate)).then_some(candidate)
+    };
+    if let Some(tid) = at(KNOWN_TID_OFFSET) {
+        return Some(tid);
+    }
+    (0..SCAN_BYTES - 4).step_by(4).find_map(at)
+}
